# --- Core ---------------------------------------------------------------
# Port the HTTP server binds to. Azure App Service injects this automatically.
PORT=3000

# Secret used to sign organizer session cookies. SET THIS IN PRODUCTION.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# When left empty the server generates a key once and stores it next to the
# database (<data dir>/session-secret), so organizer logins survive a restart
# without any setup. Only if that directory is read-only does it fall back to a
# per-process key, which signs everyone out on every restart; the boot log and
# /sysadmin both say which of the three is in effect.
SESSION_SECRET=

# Absolute or relative path to the SQLite database file. This is the one path
# that has to live on persistent storage - the WAL, the session key and the
# backup folder are all derived from its directory.
# Local default: ./data/judgium.db
# On Azure App Service (Linux) use the persistent share: /home/data/judgium.db
DATABASE_PATH=./data/judgium.db

# Where `npm run backup` and the /sysadmin backup button write snapshots.
# Defaults to <directory of DATABASE_PATH>/backups.
# BACKUP_DIR=

# Public base URL, used when rendering judge links and the leaderboard URL.
# Leave empty to derive it from the incoming request (works behind Azure's proxy).
PUBLIC_BASE_URL=

# Where the /source link in every page footer redirects to.
#
# Judgium is AGPL-3.0, and section 13 of that licence requires that anyone who
# interacts with the program over a network be offered its COMPLETE
# CORRESPONDING SOURCE - the code actually running, not the upstream project's.
#
# If you run Judgium unmodified, leave this alone: the default points at the
# upstream repository, which is the truthful answer.
#
# IF YOU HAVE MODIFIED THE CODE, SET THIS to your own repository or source
# archive. Leaving it at the default while running a patched build is a licence
# violation, and it is the one that is easiest to commit by accident.
# SOURCE_URL=https://github.com/your-org/your-fork

# --- Capacity / concurrency --------------------------------------------
# All of these are auto-sized from the host's CPU count and memory when unset.
# Set them explicitly only if you want to override the computed defaults.

# Max simultaneous live-update (SSE) subscribers held open by one instance.
# MAX_LIVE_CLIENTS=

# Requests per minute allowed per client IP for read endpoints / write endpoints.
# RATE_LIMIT_READ=
# RATE_LIMIT_WRITE=

# Minimum milliseconds between two recomputes+broadcasts of the same leaderboard.
# Raise it for very large events to trade freshness for CPU.
# LEADERBOARD_THROTTLE_MS=

# Max entries returned in one leaderboard payload (0 = unlimited).
# LEADERBOARD_MAX_ROWS=0

# --- Behaviour ----------------------------------------------------------
# Set to 1 to disallow self-service organizer sign-up (invite/seed only).
DISABLE_SIGNUP=0

# NOTE: DISABLE_SIGNUP and SIGNUP_ALLOWLIST govern ORGANIZER registration only.
# Participant accounts are created through a competition's own submission link
# (/enter/<slug>) and are gated by that competition's submission window, not by
# these settings - closing organizer sign-up does not close your events to
# entrants.
#
# Comma-separated allowlist of organizer e-mail addresses permitted to sign up.
# Empty means anyone may sign up (unless DISABLE_SIGNUP=1).
SIGNUP_ALLOWLIST=

# --- Platform administration -------------------------------------------
# Comma-separated accounts promoted to platform administrator (superuser) at
# boot and on sign-up. This is the only way to mint the first one: the role
# grants cross-tenant access to every account and competition at /sysadmin, so
# there is no self-service route to it. Idempotent - listing an address that is
# already an administrator does nothing. Afterwards they manage each other in
# the UI, or from the CLI with: npm run promote -- <e-mail>
SUPERADMIN_EMAILS=
