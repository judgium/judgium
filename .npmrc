# better-sqlite3 ships a prebuilt binary for every platform inside its npm
# tarball and prefers it over a local build, so nothing here needs a compiler.
# npm would otherwise run an implicit `node-gyp rebuild` just because the
# package contains a binding.gyp, which turns a 3-second install into a
# multi-minute compile - and fails outright on any image without Python and a
# C++ toolchain. Disabling dependency install scripts keeps `npm ci` fast and
# portable, and incidentally stops third-party packages running code at
# install time.
#
# This does NOT affect `npm start`, `npm test` or any other `npm run` script.
# If you ever add a dependency that genuinely needs its install script, install
# it with `npm install <pkg> --foreground-scripts --ignore-scripts=false`.
ignore-scripts=true

# Keep lockfile resolution reproducible across machines.
save-exact=false
fund=false
