<?xml version="1.0" encoding="utf-8"?>
<!--
  Only needed on **Windows** App Service, where Node runs behind iisnode.
  Linux App Service ignores this file and uses the startup command instead.

  Linux is the recommended target: iisnode buffers responses, which delays the
  Server-Sent Events stream that drives the live leaderboard. On Windows the
  board still updates, but via the client's polling fallback rather than push.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="StaticContent" stopProcessing="true">
          <match url="^(css|js|i18n|favicon\.svg)(/.*)?$" />
          <action type="None" />
        </rule>
        <rule name="Application">
          <match url="/*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>
    <iisnode nodeProcessCommandLine="node.exe" watchedFiles="web.config;*.js" loggingEnabled="true" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="data" />
          <add segment="src" />
          <add segment="test" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
